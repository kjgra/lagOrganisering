# Nymark – Gruppeorganisering: miljøvariabler.
# Kopier til .env.local for lokal utvikling. Sett de samme i Vercel
# (Settings → Environment Variables) for Preview og Production.

# --- Simulering (bare lokalt og i Preview, aldri i Production) ---
# Falsk Spond med demodata. Logg inn med kjetil@demo.no / demo (superadmin),
# ann@demo.no (app + KI), beate@demo.no (ingen app-tilgang).
SPOND_MOCK=true
# Simulert KI når ANTHROPIC_API_KEY mangler.
AI_MOCK=true
# Uten DATABASE_URL brukes PGlite (Postgres i prosessen). Mappe for data
# mellom omstarter; tom = bare i minnet.
PGLITE_DIR=.data/pglite

# --- Påkrevd i Production ---
# Krypterer innloggings-cookien (minst 32 tegn). Lag med: openssl rand -base64 48
SESSION_SECRET=
# Supabase Postgres via transaction pooler (port 6543), med passord.
# postgresql://postgres.<prosjekt-ref>:<passord>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Spond-profil-ID til superadmin (står alltid utenfor databasen, kan ikke låses ute).
SUPERADMIN_PROFILE_ID=

# --- Valgfritt ---
# KI (Claude API). Uten nøkkel er KI av (eller simulert med AI_MOCK=true utenfor Production).
ANTHROPIC_API_KEY=
# Merkelapp ved logoen, f.eks. TEST. Tom i Production.
APP_ENV=
# Spond-roller som gir tilgang til appen (kommaseparert).
ACCESS_ROLE_NAMES=Teamleder,Trener,Lagleder,Hovedlagleder
# Spond-roller som regnes som trenere (fordeles ikke på lag).
COACH_ROLE_NAMES=Teamleder,Trener,Lagleder,Hovedlagleder,Hjelpetrener,Keepertrener,Hjelper
# Faste forslag til tagger.
TAG_SUGGESTIONS=Keeper,Kaptein,Forsvar,Midtbane,Angrep,Ny

# --- Påminnelse etter trening (valgfritt) ---
# Varsler på mobilen (Web Push). Lag nøklene én gang med: npx web-push generate-vapid-keys
# Uten nøkler får trenerne bare påminnelsen inne i appen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt for push-tjenestene: mailto:adresse eller https-adresse.
VAPID_SUBJECT=
# Hemmelighet som GitHub-workflowen «Påminnelser» bruker for å be appen sende påminnelser.
# Lag med: openssl rand -base64 32. Samme verdi som repo-secret CRON_SECRET.
CRON_SECRET=

# --- Tilbakemeldinger til GitHub (valgfritt) ---
# Fine-grained token med bare «Issues: Read and write» på repoet. Sett den bare for
# Production i Vercel. Uten token lagres tilbakemeldingene bare i innboksen i admin.
# Med simulert Spond (demo, preview) later appen som om den sender.
GITHUB_FEEDBACK_TOKEN=
# Repoet issuene havner i (eier/navn).
GITHUB_FEEDBACK_REPO=kjgra/lagOrganisering
